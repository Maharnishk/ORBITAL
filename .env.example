# ORBITAL environment template.
#
# Copy to `.env` in this directory and adjust. `.env` is gitignored; this
# example file is committed. Docker Compose reads `.env` automatically for
# variable interpolation, and the backend reads it through pydantic-settings
# when run from `backend/` on the host.
#
# Never put database credentials in NEXT_PUBLIC_* variables: everything
# prefixed with NEXT_PUBLIC_ is embedded in browser JavaScript.

# --- Backend (FastAPI) ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLAlchemy URL used by the API, Alembic and the seed command on the host.
# The compose `api` service overrides this with host `db` automatically.
DATABASE_URL=postgresql+psycopg://orbital:orbital_dev_only@localhost:5432/orbital

# Exact browser origins allowed by CORS, comma-separated. Wildcards are
# rejected by the application configuration.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL container (docker compose) ---
POSTGRES_USER=orbital
POSTGRES_PASSWORD=orbital_dev_only
POSTGRES_DB=orbital

# --- API container startup (docker compose) ---
# Development-only convenience: migrate and load the simulation seed when the
# container starts. The seed is idempotent and never writes "verified" rows.
# Set SEED_SIMULATION=0 to start with an empty database.
SEED_SIMULATION=1
SEED_COUNT=72

# --- Frontend (Next.js) ---
# Base URL of the API as seen by the browser, not by the container.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
